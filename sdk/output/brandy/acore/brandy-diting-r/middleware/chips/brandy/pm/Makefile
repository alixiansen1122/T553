	cd /work/shishimao/T553_code/software/code/sdk/output/brandy/acore/brandy-diting-r && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
.PHONY : cmake_check_build_system

